# bytecode against it without needing Foundry.
!contracts/out/QoreGuardTreasury.sol/
contracts/out/QoreGuardTreasury.sol/*
!contracts/out/QoreGuardTreasury.sol/QoreGuardTreasury.json
__pycache__/
*.pyc
.venv/
.pytest_cache/
broadcast/

# coverage and log artifacts
contracts/lcov.info
