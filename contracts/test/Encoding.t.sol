pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {QoreGuardTreasury} from "../src/QoreGuardTreasury.sol";

/// @notice The off-chain encoder (`agent/qoreguard/treasury.py`) must produce the
///         same bytes the contract does. These constants were generated by that
///         encoder; if either side drifts, this test fails before a transaction
///         is ever signed.
contract EncodingTest is Test {
    address internal constant CONTRACT = 0x1111111111111111111111111111111111111111;
    address internal constant PAYEE = 0x2222222222222222222222222222222222222222;
    address internal constant OWNER = 0x3333333333333333333333333333333333333333;

    /// forge-config: default.fuzz.runs = 256
    function testAddVendorPayloadAndMessageMatchOffChainEncoder() public {
        QoreGuardTreasury t = new QoreGuardTreasury(OWNER, 1);
        // The constructor chain id is the foundry chain id (31337) by default, so
        // the message test below uses a small helper contract view instead.
        bytes32 payload = keccak256(abi.encode(uint256(1), PAYEE, keccak256("cloud-hosting"), uint96(200_000), uint96(1_000_000)));
        assertEq(payload, 0x9f92dfe81ab04ffb8b61d037fd7e694db3bfcd699464321b9fceb2648b5865fd, "addVendor payload");

        // adminMessage() on a chain with id 9800: reproduce the same expression.
        bytes memory message = abi.encodePacked(
            "QoreGuard.treasury.v1",
            uint256(9800),
            CONTRACT,
            keccak256("addVendor"),
            payload,
            uint256(7)
        );
        assertEq(message.length, 169, "message length");
        assertEq(keccak256(message), 0xb47bf6aa3a249ae8d9cc72d82b4ffb56e864ffcc43a89f3b8a31da977320178d, "admin message");
        t;
    }

    function testSelectorsMatchOffChainEncoder() public pure {
        assertEq(bytes4(keccak256("pay(uint256,uint256,bytes32)")), bytes4(0x62bc84af));
        assertEq(
            bytes4(keccak256("payWithApproval(uint256,uint256,bytes32,uint256,bytes,bytes)")),
            bytes4(0xd98d5dc8)
        );
        assertEq(
            bytes4(keccak256("addVendor(uint256,address,bytes32,uint96,uint96,uint256,bytes,bytes)")),
            bytes4(0xe198fe9a)
        );
        assertEq(bytes4(keccak256("setTreasuryCap(uint96,uint256,bytes,bytes)")), bytes4(0x49bae14f));
    }

    function testExceptionPayloadMatchesOffChainEncoder() public pure {
        bytes32 payload = keccak256(abi.encode(uint256(1), uint256(500_000), keccak256("INV-1002 GPU burst overage above the agreed cap")));
        assertEq(payload, 0xdf240e2ebfb97394dddde5be2c16efe69736f42c0e57dc54eab85914fd9db1e3);
    }
}
