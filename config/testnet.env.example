# QoreGuard — QoreChain testnet (qorechain-diana) configuration
# Copy to ../.env (gitignored) and fill from your own key material.
QORE_CHAIN_ID=qorechain-diana
QORE_REST=https://api-testnet.qore.host
QORE_RPC=https://rpc-testnet.qore.host
QORE_EVM_RPC=https://evm-testnet.qore.host
QORE_EVM_CHAIN_ID=9800

# owner: the canonical PQC-required account that holds the treasury.
# Its ML-DSA-87 key is derived from this phrase (canonical derivation), so the
# phrase alone restores the post-quantum key too.
QORE_OWNER_MNEMONIC=""

# relayer: a separate gas-only account that submits the agent's requests and
# pays the fees. It never holds the treasury.
QORE_RELAYER_MNEMONIC=""

# agent: the hot ed25519 key that signs spend intents. No funds, no PQC key.
QORE_AGENT_KEY_PATH=.keys/agent_ed25519.key
